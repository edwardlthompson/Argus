<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <title>Argus — {{ view.target_label }}</title>
  <style>
    :root {
      --bg0: #0b1220;
      --bg1: #132033;
      --ink: #e8eef7;
      --muted: #8fa0b8;
      --line: #243247;
      --accent: #4aa3f0;
      --good: #3dd68c;
      --warn: #e6b84d;
      --bad: #f07178;
      --card: rgba(18, 28, 44, 0.78);
      --card-hover: rgba(24, 38, 60, 0.92);
      --track: #0a101a;
      --chip: #182538;
      --plot-fill: #4aa3f0;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      color: var(--ink);
      font-family: "Source Sans 3", "Segoe UI", system-ui, -apple-system, sans-serif;
      background:
        radial-gradient(ellipse 80% 50% at 10% -10%, #1a3a5c 0%, transparent 55%),
        radial-gradient(ellipse 60% 40% at 90% 0%, #1e2d4a 0%, transparent 50%),
        linear-gradient(180deg, var(--bg1), var(--bg0));
      min-height: 100vh;
    }
    .wrap { max-width: 1120px; margin: 0 auto; padding: 2.25rem 1.25rem 3.5rem; }
    .hero { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 1rem; margin-bottom: 1rem; }
    .hero h1 {
      font-family: "Fraunces", Georgia, serif;
      font-size: clamp(2.2rem, 5vw, 3.1rem);
      letter-spacing: -0.03em;
      margin: 0 0 0.35rem;
      line-height: 1.05;
    }
    .hero p { color: var(--muted); margin: 0; font-size: 0.95rem; }
    .hero-links { display: flex; gap: 0.6rem; flex-wrap: wrap; }
    .hero-links a {
      font-size: 0.82rem;
      color: var(--muted);
      text-decoration: none;
      border: 1px solid var(--line);
      background: var(--card);
      padding: 0.38rem 0.7rem;
      border-radius: 6px;
    }
    .hero-links a:hover { color: var(--ink); border-color: var(--accent); }
    .banner {
      border-left: 3px solid var(--accent);
      background: rgba(74, 163, 240, 0.08);
      padding: 0.65rem 0.9rem;
      margin: 0 0 1.25rem;
      color: var(--muted);
      font-size: 0.9rem;
      border-radius: 0 6px 6px 0;
    }

    /* Top Operational KPI Strip */
    .stats {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(155px, 1fr));
      gap: 0.75rem;
      margin: 1.25rem 0 1.75rem;
    }
    .stat {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 0.95rem 1.05rem;
      position: relative;
      overflow: hidden;
    }
    .stat::before {
      content: "";
      position: absolute;
      left: 0; top: 0; bottom: 0;
      width: 3px;
      background: var(--accent);
    }
    .stat.tone-good::before { background: var(--good); }
    .stat.tone-warn::before { background: var(--warn); }
    .stat.tone-bad::before { background: var(--bad); }
    .stat .n { font-size: 1.7rem; font-weight: 700; line-height: 1.15; font-variant-numeric: tabular-nums; }
    .stat.tone-good .n { color: var(--good); }
    .stat.tone-warn .n { color: var(--warn); }
    .stat.tone-bad .n { color: var(--bad); }
    .stat .l { color: var(--muted); font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.05em; margin-top: 0.25rem; }
    .stat .sub { color: var(--muted); font-size: 0.76rem; margin-top: 0.3rem; font-variant-numeric: tabular-nums; }

    h2 {
      font-family: "Fraunces", Georgia, serif;
      font-size: 1.32rem;
      margin: 2rem 0 0.8rem;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .section-note { color: var(--muted); font-size: 0.88rem; margin: -0.45rem 0 0.9rem; }

    /* Scorecard Gauges */
    .gauges {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 0.85rem;
    }
    .gauge-card {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 1.1rem 1.15rem;
      display: flex;
      align-items: center;
      gap: 1rem;
    }
    .ring { width: 84px; height: 84px; flex-shrink: 0; }
    .ring svg { width: 84px; height: 84px; transform: rotate(-90deg); }
    .ring circle.bg { fill: none; stroke: var(--track); stroke-width: 8; }
    .ring circle.fg { fill: none; stroke-width: 8; stroke-linecap: round; }
    .ring circle.tone-good { stroke: var(--good); }
    .ring circle.tone-warn { stroke: var(--warn); }
    .ring circle.tone-bad { stroke: var(--bad); }
    .gauge-meta .pct { font-size: 1.55rem; font-weight: 700; line-height: 1.1; font-variant-numeric: tabular-nums; }
    .gauge-meta .title { font-size: 0.92rem; font-weight: 600; margin-top: 0.15rem; }
    .gauge-meta .sub { font-size: 0.8rem; color: var(--muted); margin-top: 0.2rem; }

    /* Target First Queue */
    .targets {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
      gap: 0.85rem;
    }
    .target-card {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 0.95rem 1.05rem;
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
    }
    .target-card.has-red { border-color: rgba(240, 113, 120, 0.55); }
    .target-head { display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; }
    .target-rank {
      display: inline-flex; align-items: center; justify-content: center;
      width: 1.65rem; height: 1.65rem; border-radius: 999px;
      background: var(--chip); color: var(--accent); font-weight: 700; font-size: 0.8rem;
      flex-shrink: 0;
    }
    .target-name { font-weight: 650; font-size: 1rem; color: var(--ink); text-decoration: none; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .target-name:hover { color: var(--accent); text-decoration: underline; }
    .pills { display: flex; flex-wrap: wrap; gap: 0.35rem; }
    .pill {
      display: inline-block;
      font-size: 0.74rem;
      font-weight: 600;
      padding: 0.18rem 0.52rem;
      border-radius: 999px;
      border: 1px solid transparent;
      white-space: nowrap;
    }
    .pill-good { background: rgba(61, 214, 140, 0.14); color: var(--good); border-color: rgba(61, 214, 140, 0.32); }
    .pill-warn { background: rgba(230, 184, 77, 0.14); color: var(--warn); border-color: rgba(230, 184, 77, 0.32); }
    .pill-bad  { background: rgba(240, 113, 120, 0.16); color: var(--bad);  border-color: rgba(240, 113, 120, 0.38); }
    .pill-info { background: rgba(74, 163, 240, 0.14); color: var(--accent); border-color: rgba(74, 163, 240, 0.32); }
    .pill-muted { background: var(--chip); color: var(--muted); border-color: var(--line); }
    .target-links { display: flex; gap: 0.65rem; font-size: 0.8rem; margin-top: auto; padding-top: 0.25rem; border-top: 1px solid rgba(36, 50, 71, 0.6); }
    .target-links a { color: var(--accent); text-decoration: none; }
    .target-links a:hover { text-decoration: underline; }
    .all-clear {
      background: rgba(61, 214, 140, 0.09);
      border: 1px solid rgba(61, 214, 140, 0.35);
      border-radius: 8px;
      padding: 1rem 1.2rem;
      color: var(--good);
      font-weight: 600;
    }

    /* Charts & Panels */
    .charts {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 0.85rem;
    }
    .panel {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 1rem 1.15rem;
    }
    .panel h3 {
      margin: 0 0 0.8rem;
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--muted);
      font-weight: 650;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .hbar { display: grid; gap: 0.48rem; }
    .hbar-row {
      display: grid;
      grid-template-columns: minmax(6.5rem, 34%) 1fr auto;
      gap: 0.55rem;
      align-items: center;
      font-size: 0.86rem;
    }
    .hbar-row a { color: var(--ink); text-decoration: none; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .hbar-row a:hover { color: var(--accent); }
    .track { height: 10px; background: var(--track); border-radius: 999px; overflow: hidden; display: flex; }
    .track > i { display: block; height: 100%; background: var(--accent); }
    .seg-issues { background: var(--bad) !important; }
    .seg-fixes  { background: var(--warn) !important; }
    .seg-prs    { background: var(--accent) !important; }
    .val { color: var(--muted); font-variant-numeric: tabular-nums; min-width: 2.2rem; text-align: right; font-size: 0.82rem; }
    .legend-inline { display: flex; gap: 0.85rem; font-size: 0.74rem; color: var(--muted); margin-top: 0.75rem; flex-wrap: wrap; }
    .swatch { width: 0.6rem; height: 0.6rem; border-radius: 2px; display: inline-block; margin-right: 0.3rem; vertical-align: middle; }
    .swatch-issues { background: var(--bad); }
    .swatch-fixes { background: var(--warn); }
    .swatch-prs { background: var(--accent); }

    /* Filterable Fleet Table */
    .fleet-controls {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 0.85rem;
    }
    .filter-pills { display: flex; flex-wrap: wrap; gap: 0.4rem; }
    .filter-btn {
      background: var(--chip);
      color: var(--muted);
      border: 1px solid var(--line);
      border-radius: 999px;
      padding: 0.34rem 0.78rem;
      font-size: 0.8rem;
      font-weight: 600;
      cursor: pointer;
    }
    .filter-btn:hover { color: var(--ink); border-color: var(--accent); }
    .filter-btn.active { background: rgba(74, 163, 240, 0.18); color: var(--accent); border-color: var(--accent); }
    .search-box {
      background: var(--track);
      color: var(--ink);
      border: 1px solid var(--line);
      border-radius: 6px;
      padding: 0.4rem 0.75rem;
      font-size: 0.85rem;
      min-width: 210px;
    }
    .search-box:focus { outline: none; border-color: var(--accent); }
    .table-wrap { overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; font-size: 0.88rem; }
    th, td { text-align: left; padding: 0.58rem 0.45rem; border-bottom: 1px solid var(--line); vertical-align: middle; }
    th { color: var(--muted); font-weight: 600; font-size: 0.76rem; text-transform: uppercase; letter-spacing: 0.05em; }
    tbody tr:hover { background: rgba(74, 163, 240, 0.05); }
    td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }
    td a { color: var(--ink); text-decoration: none; font-weight: 600; }
    td a:hover { color: var(--accent); text-decoration: underline; }
    .muted-zero { color: #52627a; }
    .ci-dot { display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.8rem; font-weight: 600; }
    .ci-dot i { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }
    .ci-passing { color: var(--good); }
    .ci-passing i { background: var(--good); }
    .ci-failing { color: var(--bad); }
    .ci-failing i { background: var(--bad); }
    .ci-none { color: var(--muted); }
    .ci-none i { background: #52627a; }

    footer { margin-top: 2.5rem; color: var(--muted); font-size: 0.82rem; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem; }
    a { color: var(--accent); }
    .empty { color: var(--muted); margin: 0; font-size: 0.88rem; }
  </style>
</head>
<body>
  <div class="wrap">
    <header class="hero">
      <div>
        <h1>Argus</h1>
        <p>{{ view.target_label }} portfolio health · {{ view.generated_at }} · mode {{ view.mode }}</p>
      </div>
      <div class="hero-links">
        <a href="health-infographic.svg">Infographic SVG</a>
        <a href="health-infographic.html">Snapshot Summary</a>
      </div>
    </header>

    {% if view.report_banner %}<div class="banner">{{ view.report_banner }}</div>{% endif %}
    {% if view.actions_unavailable %}
    <div class="banner">Actions unavailable — free-tier local path. Paying for minutes is not required.</div>
    {% endif %}

    <!-- Top Operational KPI Strip -->
    <div class="stats">
      <div class="stat">
        <div class="n">{{ view.stats.active }}</div>
        <div class="l">Active Repos</div>
        <div class="sub">{{ view.stats.repos }} total{% if view.stats.archived %} · {{ view.stats.archived }} archived{% endif %}</div>
      </div>
      <div class="stat tone-{{ 'good' if view.stats.ci_pass_pct >= 85 else ('warn' if view.stats.ci_pass_pct >= 60 else 'bad') }}">
        <div class="n">{{ view.stats.ci_pass_pct }}%</div>
        <div class="l">CI Health</div>
        <div class="sub">{{ view.stats.ci_passing }}/{{ view.stats.ci_total }} passing{% if view.stats.ci_failing %} · {{ view.stats.ci_failing }} failing{% endif %}</div>
      </div>
      <div class="stat tone-{{ 'good' if view.stats.open_issues == 0 else ('warn' if view.stats.open_issues <= 3 else 'bad') }}">
        <div class="n">{{ view.stats.open_issues }}</div>
        <div class="l">Open Issues</div>
        <div class="sub">PRs excluded</div>
      </div>
      <div class="stat tone-{{ 'good' if view.stats.open_prs == 0 else 'warn' }}">
        <div class="n">{{ view.stats.open_prs }}</div>
        <div class="l">Open PRs</div>
        <div class="sub">{{ view.stats.pr_dependabot }} dep · {{ view.stats.pr_release }} rel · {{ view.stats.pr_feature }} feat</div>
      </div>
      <div class="stat tone-{{ 'good' if view.stats.open_fixes == 0 else 'warn' }}">
        <div class="n">{{ view.stats.open_fixes }}</div>
        <div class="l">Open Fixes</div>
        <div class="sub">{{ view.stats.auto_fixes }} auto · {{ view.stats.agent_fixes }} agent · {{ view.stats.human_fixes }} human</div>
      </div>
      <div class="stat tone-{{ 'good' if view.stats.hygiene_clean_pct >= 85 else ('warn' if view.stats.hygiene_clean_pct >= 60 else 'bad') }}">
        <div class="n">{{ view.stats.hygiene_clean_pct }}%</div>
        <div class="l">Hygiene Clean</div>
        <div class="sub">{{ view.stats.hygiene_clean }}/{{ view.stats.active }} repos at 0 fixes</div>
      </div>
    </div>

    <!-- Portfolio Health Scorecard -->
    <h2>Portfolio Health Scorecard</h2>
    <div class="gauges">
      {% for g in view.charts.health_gauges %}
      <div class="gauge-card">
        <div class="ring" aria-label="{{ g.label }} {{ g.pct }}%">
          <svg viewBox="0 0 84 84">
            <circle class="bg" cx="42" cy="42" r="36"></circle>
            <circle class="fg tone-{{ g.tone }}" cx="42" cy="42" r="36"
              stroke-dasharray="{{ g.circumference }}"
              stroke-dashoffset="{{ g.offset }}"></circle>
          </svg>
        </div>
        <div class="gauge-meta">
          <div class="pct">{{ g.pct }}%</div>
          <div class="title">{{ g.label }}</div>
          <div class="sub">{{ g.subtitle }}</div>
        </div>
      </div>
      {% endfor %}
    </div>

    <!-- Fix These First -->
    <h2>Fix These First</h2>
    <p class="section-note">Top priority targets ranked by Red CI → Open Issues → Hygiene Fixes → Open PRs.</p>
    {% if view.target_first %}
    <div class="targets">
      {% for t in view.target_first %}
      <div class="target-card{% if t.ci_failed %} has-red{% endif %}">
        <div class="target-head">
          <span class="target-rank">#{{ t.rank }}</span>
          <a class="target-name" href="{{ t.url }}" target="_blank" rel="noopener">{{ t.name }}</a>
        </div>
        <div class="pills">
          {% for r in t.reasons %}
          <span class="pill pill-{{ r.tone }}">{{ r.text }}</span>
          {% endfor %}
        </div>
        <div class="target-links">
          <a href="{{ t.actions_url }}" target="_blank" rel="noopener">Actions</a>
          <a href="{{ t.issues_url }}" target="_blank" rel="noopener">Issues ({{ t.issues }})</a>
          <a href="{{ t.prs_url }}" target="_blank" rel="noopener">PRs ({{ t.prs }})</a>
        </div>
      </div>
      {% endfor %}
    </div>
    {% else %}
    <div class="all-clear">All clear — 0 failing CI workflows, 0 open issues, 0 open fixes, and 0 open PRs across the active fleet.</div>
    {% endif %}

    <!-- Operational Breakdown Charts -->
    <h2>Backlog &amp; Hygiene Breakdown</h2>
    <div class="charts">
      <div class="panel">
        <h3>PR &amp; Issue Backlog (Top 8 Repos)</h3>
        {% if view.charts.backlog_top8 %}
        <div class="hbar">
          {% for row in view.charts.backlog_top8 %}
          <div class="hbar-row">
            <a href="{{ row.url }}" target="_blank" rel="noopener" title="{{ row.name }}">{{ row.name }}</a>
            <div class="track" title="Issues: {{ row.issues }}, Fixes: {{ row.open_fixes }}, PRs: {{ row.prs }}">
              {% if row.issues_w %}<i class="seg-issues" style="width: {{ row.issues_w }}%"></i>{% endif %}
              {% if row.fixes_w %}<i class="seg-fixes" style="width: {{ row.fixes_w }}%"></i>{% endif %}
              {% if row.prs_w %}<i class="seg-prs" style="width: {{ row.prs_w }}%"></i>{% endif %}
            </div>
            <span class="val">{{ row.total }}</span>
          </div>
          {% endfor %}
        </div>
        <div class="legend-inline">
          <span><span class="swatch swatch-issues"></span>Issues</span>
          <span><span class="swatch swatch-fixes"></span>Open Fixes</span>
          <span><span class="swatch swatch-prs"></span>Open PRs</span>
        </div>
        {% else %}
        <p class="empty">Zero backlog across all active repositories.</p>
        {% endif %}
      </div>

      <div class="panel">
        <h3>Fixes by Class</h3>
        <div class="hbar">
          {% for row in view.charts.fix_classes %}
          <div class="hbar-row">
            <span>{{ row.label }}</span>
            <div class="track"><i style="width: {{ row.pct if view.stats.open_fixes else 0 }}%"></i></div>
            <span class="val">{{ row.count }}</span>
          </div>
          {% endfor %}
        </div>
        <h3 style="margin-top: 1.25rem;">Check Families</h3>
        <div class="hbar">
          {% for row in view.charts.prefix_groups %}
          <div class="hbar-row">
            <span>{{ row.label }}</span>
            <div class="track"><i style="width: {{ row.pct }}%"></i></div>
            <span class="val">{{ row.count }}</span>
          </div>
          {% else %}
          <p class="empty">No open matches — hygiene clean.</p>
          {% endfor %}
        </div>
      </div>
    </div>

    {% if view.health_delta %}
    <h2>This Run</h2>
    <div class="panel">
      <p class="empty" style="color:var(--ink)">
        Open fixes:
        <strong>{{ (view.health_delta.totals_before or {}).open_fixes }}</strong>
        →
        <strong>{{ (view.health_delta.totals_after or {}).open_fixes }}</strong>
        (Δ {{ view.health_delta.delta_open_fixes }})
      </p>
    </div>
    {% endif %}

    <!-- Filterable Fleet Table -->
    <h2>Fleet ({{ view.stats.active }})</h2>
    <p class="section-note">Every active repo — sorted by Red CI, Open Issues, Open Fixes, then Open PRs. GitHub Issues and PRs are strictly separated.</p>
    <div class="panel">
      {% if view.fleet %}
      <div class="fleet-controls">
        <div class="filter-pills" role="group" aria-label="Filter repositories">
          <button type="button" class="filter-btn active" data-filter="all">All ({{ view.stats.active }})</button>
          <button type="button" class="filter-btn" data-filter="needs_action">Needs Action ({{ view.stats.active - view.stats.zero_backlog }})</button>
          <button type="button" class="filter-btn" data-filter="red_ci">Red CI ({{ view.stats.ci_failing }})</button>
          <button type="button" class="filter-btn" data-filter="clean">Clean ({{ view.stats.zero_backlog }})</button>
        </div>
        <input id="fleet-search" class="search-box" type="search" placeholder="Search repos..." aria-label="Search repositories" />
      </div>
      <div class="table-wrap">
        <table id="fleet-table">
          <thead>
            <tr>
              <th>Repo</th>
              <th>CI</th>
              <th class="num">Issues</th>
              <th class="num">Open PRs</th>
              <th class="num">Open Fixes</th>
              <th>Last Push</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            {% for r in view.fleet %}
            <tr data-filter="{{ r.filter_key }}" data-needs="{{ '1' if r.filter_key != 'clean' else '0' }}" data-name="{{ r.name | lower }}">
              <td><a href="{{ r.url }}" target="_blank" rel="noopener">{{ r.name }}</a></td>
              <td>
                {% if r.ci_status == 'passing' %}
                <span class="ci-dot ci-passing"><i></i>Pass</span>
                {% elif r.ci_status == 'failing' %}
                <span class="ci-dot ci-failing"><i></i>Fail</span>
                {% else %}
                <span class="ci-dot ci-none"><i></i>—</span>
                {% endif %}
              </td>
              <td class="num{% if r.issues == 0 %} muted-zero{% endif %}">{{ r.issues }}</td>
              <td class="num{% if r.prs == 0 %} muted-zero{% endif %}">{{ r.prs }}</td>
              <td class="num{% if r.open_fixes == 0 %} muted-zero{% endif %}">{{ r.open_fixes }}</td>
              <td style="color:var(--muted);font-variant-numeric:tabular-nums">{{ r.pushed_at }}</td>
              <td><span class="pill pill-{{ r.status_tone }}">{{ r.status_pill }}</span></td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      {% else %}
      <p class="empty">No active repositories in this scan.</p>
      {% endif %}
    </div>

    <footer>
      <span>Public metrics only — never a per-repo security weakness catalogue.</span>
      <span>Full private report lives on the private runner.</span>
    </footer>
  </div>

  <script>
    (function () {
      var btns = document.querySelectorAll('.filter-btn');
      var search = document.getElementById('fleet-search');
      var rows = document.querySelectorAll('#fleet-table tbody tr');
      if (!rows.length) return;
      var activeFilter = 'all';
      function apply() {
        var q = (search ? search.value : '').trim().toLowerCase();
        rows.forEach(function (tr) {
          var fk = tr.getAttribute('data-filter');
          var needs = tr.getAttribute('data-needs') === '1';
          var name = tr.getAttribute('data-name') || '';
          var matchFilter =
            activeFilter === 'all' ||
            (activeFilter === 'needs_action' && needs) ||
            fk === activeFilter;
          var matchQuery = !q || name.indexOf(q) !== -1;
          tr.style.display = (matchFilter && matchQuery) ? '' : 'none';
        });
      }
      btns.forEach(function (b) {
        b.addEventListener('click', function () {
          btns.forEach(function (x) { x.classList.remove('active'); });
          b.classList.add('active');
          activeFilter = b.getAttribute('data-filter') || 'all';
          apply();
        });
      });
      if (search) search.addEventListener('input', apply);
    })();
  </script>
</body>
</html>
