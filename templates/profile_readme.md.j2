<!-- argus:profile-readme -->
<div align="center">

<img src="{{ banner_path }}" alt="{{ display_name }}" width="100%" />

{% if not banner_carries_identity %}
# {{ display_name }}

{% if tagline %}_{{ tagline }}_{% endif %}
{% endif %}

{% if include_badges and (location or blog or twitter or email) %}
<p>
{% if location %}
<img src="https://img.shields.io/badge/{{ location | replace(' ', '_') }}-location-0ea5e9?style=for-the-badge" alt="{{ location }}" />
{% endif %}
{% if blog %}
<a href="{{ blog }}"><img src="https://img.shields.io/badge/Website-0ea5e9?style=for-the-badge&logo=google-chrome&logoColor=white" alt="Website" /></a>
{% endif %}
{% if twitter %}
<a href="https://twitter.com/{{ twitter }}"><img src="https://img.shields.io/badge/@{{ twitter }}-1DA1F2?style=for-the-badge&logo=x&logoColor=white" alt="@{{ twitter }}" /></a>
{% endif %}
{% if email %}
<a href="mailto:{{ email }}"><img src="https://img.shields.io/badge/Email-6b7280?style=for-the-badge&logo=gmail&logoColor=white" alt="Email" /></a>
{% endif %}
</p>
{% endif %}

</div>

## About

{{ about }}

{% if bio %}
_{{ bio }}_
{% endif %}

{% if roles %}
## Focus

<table>
<tr>
{% for r in roles %}
<td width="{{ (100 / (roles|length)) | int }}%" valign="top" align="center">
<strong>{{ r.title }}</strong><br/>
{{ r.blurb }}
</td>
{% endfor %}
</tr>
</table>
{% endif %}

{% if capabilities %}
## What I build

<table>
<tr>
{% for c in capabilities %}
<td width="{{ (100 / (capabilities|length)) | int }}%" valign="top" align="center">
<strong>{{ c.title }}</strong><br/>
{{ c.blurb }}
</td>
{% if loop.index % 3 == 0 and not loop.last %}
</tr><tr>
{% endif %}
{% endfor %}
</tr>
</table>
{% endif %}

## Tech stack

<div align="center">
{% if languages %}
{% for lang in languages %}
<img src="{{ lang.icon_url }}" alt="{{ lang.name }}" width="48" height="48" title="{{ lang.name }}" />
{% endfor %}
{% else %}
_Languages appear after Argus scans your public repos._
{% endif %}
</div>

## Featured projects

<div align="center">
{% if featured %}
<table>
<tr>
{% for repo in featured %}
<td align="center" valign="top" width="{% if repo.visual == 'icon' %}140{% else %}{{ featured_card_width }}{% endif %}">
<a href="{{ repo.html_url }}">
{% if repo.visual == 'icon' %}
<img src="{{ repo.icon_url }}" alt="{{ repo.short }}" width="96" height="96" />
{% else %}
<img src="{{ repo.icon_url }}" alt="{{ repo.short }}" width="{{ featured_card_width }}" />
{% endif %}
</a><br/>
<strong><a href="{{ repo.html_url }}">{{ repo.short }}</a></strong>
{% if repo.description %}<br/><sub>{{ repo.description }}</sub>{% endif %}
</td>
{% if loop.index % 2 == 0 and not loop.last %}
</tr><tr>
{% endif %}
{% endfor %}
</tr>
</table>
{% else %}
_Featured public repositories will appear here after a portfolio scan._
{% endif %}
</div>

{% if principles %}
## Development principles

> {{ principles }}
{% endif %}

{% if open_to %}
## Also open to

{{ open_to }}
{% endif %}

