<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Argus Report</title>
  <style>
    :root {
      --bg: #f6f3ee;
      --ink: #1c1a16;
      --muted: #5c574e;
      --accent: #0f6b5c;
      --card: #fffdf8;
      --line: #ddd6c8;
      --warn: #8a4b12;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: "Segoe UI", "Helvetica Neue", sans-serif;
      background:
        radial-gradient(circle at top left, #e7f2ef 0%, transparent 40%),
        linear-gradient(180deg, #f6f3ee 0%, #efe8dc 100%);
      color: var(--ink);
      line-height: 1.5;
    }
    header {
      padding: 2rem 1.25rem 1rem;
      max-width: 920px;
      margin: 0 auto;
    }
    h1 { margin: 0 0 0.35rem; font-size: 2rem; letter-spacing: -0.02em; }
    .banner {
      background: #e8f5f1;
      border: 1px solid #b7d9cf;
      color: var(--accent);
      padding: 0.75rem 1rem;
      border-radius: 8px;
      margin: 1rem 0;
    }
    .summary { color: var(--muted); }
    main { max-width: 920px; margin: 0 auto; padding: 0 1.25rem 3rem; }
    section.repo {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 12px;
      padding: 1.25rem;
      margin: 1rem 0;
    }
    section.repo h2 { margin-top: 0; font-size: 1.25rem; }
    .meta { color: var(--muted); font-size: 0.95rem; }
    .task {
      border-top: 1px solid var(--line);
      padding: 1rem 0 0.25rem;
    }
    .task h3 { margin: 0 0 0.35rem; font-size: 1.05rem; }
    .why { color: var(--muted); }
    ol { padding-left: 1.2rem; }
    .done {
      background: #f3eee4;
      border-radius: 6px;
      padding: 0.5rem 0.75rem;
      margin-top: 0.5rem;
    }
    .low { color: var(--warn); font-weight: 600; }
    code { font-family: ui-monospace, Consolas, monospace; font-size: 0.9em; }
    footer { max-width: 920px; margin: 0 auto; padding: 0 1.25rem 2rem; color: var(--muted); font-size: 0.9rem; }
  </style>
</head>
<body>
  <header>
    <h1>Argus</h1>
    <p class="summary">
      {% if human_count == 0 %}
        Nothing needs you right now.
      {% elif human_count == 1 %}
        Argus needs you for 1 small task.
      {% else %}
        Argus needs you for {{ human_count }} small tasks.
      {% endif %}
    </p>
    {% if report_banner %}
      <div class="banner">{{ report_banner }}</div>
    {% endif %}
  </header>
  <main>
    {% for plan in plans %}
      <section class="repo">
        <h2>{{ plan.repo.full_name }}</h2>
        <p class="meta">
          {% if plan.score.confidence.value == 'low' %}
            <span class="low">Needs a human read</span> — raw score {{ plan.score.attention }}/100
          {% else %}
            Attention {{ plan.score.attention }}/100 ({{ plan.score.confidence.value }} confidence)
          {% endif %}
          · status {{ plan.repo.status.value }}
        </p>

        {% if plan.human_fixes %}
          <h3>Your tasks</h3>
          {% for m in plan.human_fixes %}
            <div class="task">
              <h3>H{{ loop.index }}. {{ m.fix.title }}</h3>
              <p class="why">{{ m.fix.why }}</p>
              <pre style="white-space:pre-wrap;font-family:inherit;margin:0.5rem 0;">{{ m.fix.human_steps }}</pre>
              <div class="done"><strong>Done when:</strong> {{ m.fix.gate or 'The steps above are complete.' }}</div>
            </div>
          {% endfor %}
        {% endif %}

        {% if plan.agent_fixes %}
          <h3>Agent work queued</h3>
          <ul>
            {% for m in plan.agent_fixes %}
              <li><code>{{ m.fix.id }}</code> — {{ m.fix.title }}</li>
            {% endfor %}
          </ul>
          <p class="meta">Full gated prompt is in <code>dist/runbook.md</code>.</p>
        {% endif %}

        {% if plan.auto_fixes and not plan.report_only %}
          <h3>Safe auto-fixes</h3>
          <ul>
            {% for m in plan.auto_fixes %}
              <li><code>{{ m.fix.id }}</code> — {{ m.fix.title }}</li>
            {% endfor %}
          </ul>
        {% endif %}

        {% if not plan.human_fixes and not plan.agent_fixes and not plan.auto_fixes %}
          <p class="meta">No open work.</p>
        {% endif %}
      </section>
    {% endfor %}
  </main>
  <footer>Generated by Argus. Silent when nothing needs you.</footer>
</body>
</html>
