# GitHub personal access token or fine-grained token with repo read (and write for auto-apply).
GITHUB_TOKEN=

# Optional public URL to the published HTML report (used in notifications).
ARGUS_REPORT_URL=

# Notification channels (any one is enough). Prefer these over committing secrets in YAML.
ARGUS_DISCORD_WEBHOOK=
ARGUS_TELEGRAM_BOT_TOKEN=
ARGUS_TELEGRAM_CHAT_ID=
ARGUS_WEBHOOK_URL=
# Optional: Grok Bot routine webhook (Tuesday Steward) — set on private runner secrets
GROK_STEWARD_WEBHOOK_URL=
GROK_STEWARD_WEBHOOK_KEY=
